{
  "description": "Chris's own blackjack game, made for fun",
  "author": "Chris Odegard <c.odegard@gmail.com>",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/codegard1/blackjack"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.1",
    "@fluentui/react-icons": "2.0.345",
    "mongodb": "7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"netlify/**/*.ts\"",
    "portraits": "node scripts/build-portraits.mjs",
    "simulate-history": "node scripts/simulate-history.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@netlify/functions": "6.0.3",
    "@netlify/vite-plugin": "3.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "8.57.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.4"
    },
    "p-locate@5.0.0": {
      "p-limit": "3.1.0"
    }
  },
  "allowScripts": {
    "core-js": true,
    "esbuild": true
  }
}
