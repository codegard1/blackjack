{
  "description": "Chris's own blackjack game, made for fun",
  "author": "Chris Odegard <c.odegard@gmail.com>",
  "version": "2.5.9",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/codegard1/blackjack"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.2",
    "@fluentui/react-icons": "2.0.346",
    "mongodb": "7.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "pretest": "node scripts/check-node-version.mjs",
    "prestart": "node scripts/check-node-version.mjs",
    "prebuild": "node scripts/check-node-version.mjs",
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"netlify/**/*.ts\"",
    "portraits": "node scripts/build-portraits.mjs",
    "animations": "node scripts/build-haber-animations.mjs && node scripts/build-faxe-animations.mjs && node scripts/build-ogion-animations.mjs && node scripts/build-shevek-animations.mjs && node scripts/build-genly-ai-animations.mjs",
    "simulate-history": "node scripts/simulate-history.mjs",
    "strategy-chart": "node scripts/basic-strategy.mjs",
    "aggregate-stats": "node scripts/aggregate-stats.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@netlify/functions": "6.1.1",
    "@netlify/vite-plugin": "3.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.4"
    },
    "p-locate@5.0.0": {
      "p-limit": "3.1.0"
    }
  },
  "allowScripts": {
    "core-js": true,
    "esbuild": true
  }
}
