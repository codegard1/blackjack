# Local development only. Copy this file to .env (which git ignores) and fill in the
# values; `npm start` loads them for the Netlify functions emulated by the Vite plugin.
# In production the same two variables are set in the Netlify UI, never in the repo.

# Atlas connection string from Connect > Drivers > Node.js, with the database user's
# credentials filled in. URL-encode any special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=blackjack

# The database the functions read and write. The database user should have the
# readWrite role on this database only.
MONGODB_DB=blackjack

# Signs the owner ids the server issues to browsers; only ids it signed are served.
# Any random string of 32 or more characters, for example from `openssl rand -base64 32`.
# Changing it orphans every existing document (they expire after 90 days).
OWNER_ID_SECRET=
